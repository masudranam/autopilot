# Copy to .env and adjust. Never commit .env — it is gitignored and hook-blocked.

# ---------- Infrastructure (must match infra/docker-compose.yml) ----------
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_dev_password
POSTGRES_DB=ecommerce
POSTGRES_PORT=5442

REDIS_PORT=6389

MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# ---------- API ----------
NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
DATABASE_URL=postgresql://ecommerce:ecommerce_dev_password@localhost:5442/ecommerce?schema=public
REDIS_URL=redis://localhost:6389

# Generate real values with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_me_with_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Mail ----------
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM="Agentic Shop <no-reply@agentic-shop.test>"

# ---------- Object storage ----------
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ---------- Payments ----------
# 'mock' is the default and needs no keys — it is what dev, CI and tests run against.
# Switch to 'stripe' only once real test keys are present below.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------- Frontends ----------
STOREFRONT_PORT=3000
ADMIN_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
