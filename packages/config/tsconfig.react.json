{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js / React — bundler resolution, JSX preserved for the Next compiler.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  }
}
