{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,

    // Must live INSIDE dist/, which is what turbo.json declares as this task's output.
    //
    // With the default location (package root) the tsbuildinfo is invisible to Turbo:
    // restoring or clearing the cache does not touch it. Delete dist/ while the
    // tsbuildinfo survives and tsc concludes there is nothing to rebuild — it emits
    // zero files and exits 0, Turbo caches that empty result, and every later
    // `import from '@repo/contracts'` fails against a package whose main/types point
    // at files that do not exist, with the gate reporting green throughout.
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
