{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API — modular monolith over the Prisma 7 data foundation",
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "prisma generate && eslint src prisma scripts",
    "test": "prisma migrate deploy && prisma generate && prisma db seed && jest",
    "dev": "prisma generate && tsc-watch -p tsconfig.build.json --onSuccess \"node dist/src/main.js\"",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:dev": "prisma migrate dev && prisma generate",
    "db:seed": "prisma generate && prisma db seed",
    "db:reset": "node scripts/db-reset.mjs",
    "db:assert-seeded": "prisma generate && tsx scripts/assert-seeded.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@repo/contracts": "workspace:*",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.29",
    "@repo/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/supertest": "7.2.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "express": "5.2.1",
    "jest": "30.4.2",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsc-watch": "7.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
