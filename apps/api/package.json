{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API — modular monolith (Nest itself arrives in F4; F3 is the data foundation)",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma",
    "test": "prisma migrate deploy && prisma db seed && jest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force --skip-seed && prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@repo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "jest": "30.4.2",
    "prisma": "7.9.1",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
